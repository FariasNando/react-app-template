{
  "vendor": "frncubo",
  "name": "technical-assistance",
  "version": "0.0.0",
  "title": "App de assistencia tecnica",
  "builders": {
    "docs": "0.x",
    "react": "3.x",
    "styles": "2.x",
    "store": "0.x",
    "graphql": "1.x",
    "node": "6.x"
  },
  "policies": [
    {
      "name": "ADMIN_DS"
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "api.vtex.com",
        "path": "/dataentities/*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "frncubo.vtexcommercestable.com.br",
        "path": "*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "portal.vtexcommercestable.com.br",
        "path": "/api/checkout/pub/postal-code/BRA/*"
      }
    }
  ],
  "dependencies": {
    "vtex.css-handles": "1.x",
    "vtex.render-runtime": "8.x",
    "vtex.device-detector": "0.x",
    "vtex.styleguide": "9.x",
    "vtex.rich-text": "0.x"
  },
  "$schema": "https://raw.githubusercontent.com/vtex/node-vtex-api/master/gen/manifest.schema"
}
